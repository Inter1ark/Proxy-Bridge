# /etc/systemd/system/proxybridge.service
# Expects the repository checked out at /opt/proxybridge with a venv in /opt/proxybridge/server/.venv
[Unit]
Description=ProxyBridge license and payment API
After=network.target

[Service]
Type=simple
User=proxybridge
Group=proxybridge
WorkingDirectory=/opt/proxybridge/server
EnvironmentFile=/opt/proxybridge/server/.env
ExecStart=/opt/proxybridge/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/proxybridge/server/data

[Install]
WantedBy=multi-user.target
