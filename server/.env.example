# Public base URL of the site (no trailing slash)
BASE_URL=https://www.proxybridge.org

# Secret for admin endpoints (header X-Admin-Token). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# Web admin panel at /admin (login form). Empty values disable the login.
# The session cookie is signed with ADMIN_TOKEN.
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Emails of test purchases, hidden in the admin stats by default (comma separated)
ADMIN_TEST_EMAILS=test@proxybridge.org

# YooKassa (shop id and secret key from the merchant dashboard)
YOOKASSA_SHOP_ID=000000
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, default is {BASE_URL}/success.html?token={token}
# YOOKASSA_RETURN_URL=https://www.proxybridge.org/success.html?token={token}

# CryptoBot (Crypto Pay API token from @CryptoBot -> Crypto Pay -> My Apps)
CRYPTOPAY_API_TOKEN=12345:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (optional; when SMTP_HOST is empty keys are only written to the log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Database (default: sqlite file in server/data/proxybridge.db)
# DATABASE_URL=sqlite:///data/proxybridge.db

# Devices per key
MAX_DEVICES=2

LOG_LEVEL=INFO

# Telegram: уведомления админам о каждой оплате (бот используется только для отправки)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789,987654321
# Если хостер блокирует Telegram: SOCKS5-прокси для Bot API (например, SSH-туннель до другого сервера)
TELEGRAM_PROXY=
