<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- macOS publish (-r osx-arm64 / osx-x64) uses the neutral TFM; everything else keeps net9.0-windows. -->
    <IsMacPublish Condition="$(RuntimeIdentifier.StartsWith('osx'))">true</IsMacPublish>
    <TargetFramework Condition="'$(IsMacPublish)' == 'true'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(IsMacPublish)' != 'true'">net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ProxyBridge</AssemblyName>
    <RootNamespace>ProxyBridge.GUI</RootNamespace>
    <Version>3.3.0</Version>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\logo.ico" />
    <!-- Oswald (display) and JetBrains Mono (technical text), SIL OFL 1.1, see Assets/Fonts/OFL-*.txt -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- Country flags 48x36 (flagcdn.com, public domain), see Assets/Flags/README.txt -->
    <AvaloniaResource Include="Assets\Flags\*.png" />
  </ItemGroup>

  <!-- UI strings: Assets/i18n/ru.json and en.json, loaded by Services/I18n.cs as "i18n.<lang>.json" -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\i18n\*.json" LogicalName="i18n.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- App icons for the routing diagram (Icon.ExtractAssociatedIcon), Windows only -->
  <ItemGroup Condition="'$(IsMacPublish)' != 'true'">
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <!-- Нативные зависимости: ProxyBridgeCore.dll, WinDivert.dll, WinDivert64.sys (Windows only) -->
  <ItemGroup Condition="'$(IsMacPublish)' != 'true'">
    <None Include="..\ProxyBridgeCore.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="ProxyBridgeCore.dll" />
    <None Include="..\WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="WinDivert64.sys" />
  </ItemGroup>

  <!-- WinDivert.dll из установленного пакета -->
  <ItemGroup Condition="'$(IsMacPublish)' != 'true' And Exists('C:\WinDivert-2.2.2-A\x64\WinDivert.dll')">
    <None Include="C:\WinDivert-2.2.2-A\x64\WinDivert.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="WinDivert.dll" />
  </ItemGroup>
</Project>
