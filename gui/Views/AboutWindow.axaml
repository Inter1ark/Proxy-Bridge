<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyBridge.GUI.ViewModels"
        x:Class="ProxyBridge.GUI.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        x:CompileBindings="True"
        Title="О программе"
        Icon="/Assets/logo.ico"
        Width="500" Height="470"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E">

    <Design.DataContext>
        <vm:AboutViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF252526" BorderBrush="#FF2D5BFF" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Viewbox Width="36" Height="24" VerticalAlignment="Center">
                    <Canvas Width="48" Height="32">
                        <Path Data="M0 32 L15 9 L27 24 L21 32 Z" Fill="#FFFFFF"/>
                        <Path Data="M13 32 L30 1 L48 32 Z" Fill="#2d5bff"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="О программе"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="32,24" Spacing="14">
            <TextBlock Text="ProxyBridge"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#FF2D5BFF"/>

            <TextBlock Text="{Binding Version}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="#FFB0B0B0"/>

            <TextBlock Text="Прокси-клиент для Windows: вся система или отдельные программы через HTTP и SOCKS5"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="#FFB0B0B0"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Clickable Links -->
            <StackPanel Spacing="10">
                <TextBlock HorizontalAlignment="Center">
                    <Run Text="Сайт: " Foreground="#FFB0B0B0"/>
                    <TextBlock Text="www.proxybridge.org"
                               Foreground="#FF2D5BFF"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               PointerPressed="OnWebsiteClick"/>
                </TextBlock>

                <TextBlock HorizontalAlignment="Center">
                    <Run Text="Поддержка: " Foreground="#FFB0B0B0"/>
                    <TextBlock Text="support@proxybridge.org"
                               Foreground="#FF2D5BFF"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               PointerPressed="OnSupportClick"/>
                </TextBlock>

                <TextBlock HorizontalAlignment="Center">
                    <Run Text="Telegram: " Foreground="#FFB0B0B0"/>
                    <TextBlock Text="t.me/inter1ark"
                               Foreground="#FF2D5BFF"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               PointerPressed="OnTelegramClick"/>
                </TextBlock>

                <TextBlock HorizontalAlignment="Center">
                    <Run Text="GitHub: " Foreground="#FFB0B0B0"/>
                    <TextBlock Text="github.com/Inter1ark/Proxy-Bridge"
                               Foreground="#FF2D5BFF"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               PointerPressed="OnGitHubClick"/>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="Лицензия кода: MIT"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="#FF808080"
                       Margin="0,8,0,0"/>

        </StackPanel>
    </Grid>
</Window>
