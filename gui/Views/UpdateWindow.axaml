<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyBridge.GUI.ViewModels"
        xmlns:i="using:ProxyBridge.GUI.Services"
        xmlns:c="using:ProxyBridge.GUI.Controls"
        x:Class="ProxyBridge.GUI.Views.UpdateWindow"
        x:DataType="vm:UpdatePresenter"
        x:CompileBindings="True"
        Title="{i:Tr upd.window_title}"
        Icon="/Assets/logo.ico"
        Width="540" SizeToContent="Height"
        MinHeight="220"
        CanResize="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner">

    <Border x:Name="Root" Background="{StaticResource PbWindowBgBrush}"
            BorderBrush="{StaticResource PbLineBrush}" BorderThickness="1">
        <StackPanel>
            <!-- title bar -->
            <Border Height="52" BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,1,*,Auto">
                    <Border Grid.ColumnSpan="4" Background="Transparent" c:TitleDrag.IsEnabled="True"/>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="22,0,20,0"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <c:BrandMark Width="30" Height="20"/>
                        <TextBlock Text="proxybridge" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,2"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="vline"/>
                    <TextBlock Grid.Column="2" Classes="hdr" Margin="20,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Text="{i:Tr upd.title_caps}"/>
                    <c:WindowButtons Grid.Column="3" ShowMinimize="False" ShowMaximize="False"/>
                </Grid>
            </Border>

            <!-- Checking -->
            <StackPanel Spacing="14" IsVisible="{Binding IsChecking}" Margin="28,36">
                <Arc Classes="spin" HorizontalAlignment="Center"/>
                <TextBlock Classes="display" FontSize="24" FontWeight="Medium" HorizontalAlignment="Center" Text="{i:Tr upd.checking_caps}"/>
                <TextBlock Classes="mono" FontSize="12.5" HorizontalAlignment="Center" Text="{Binding VersionLine}"/>
            </StackPanel>

            <!-- Up to date -->
            <StackPanel IsVisible="{Binding IsUpToDate}">
                <Grid ColumnDefinitions="Auto,*" Margin="28,26,28,24">
                    <Border Classes="ring live" Width="48" Height="48" CornerRadius="24">
                        <c:Icon Data="{StaticResource IcoCheck}" Foreground="{StaticResource PbCyanBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="display" FontSize="24" Text="{i:Tr upd.uptodate_caps}"/>
                        <TextBlock Classes="mono" FontSize="12.5" TextWrapping="Wrap" Text="{Binding UpToDateText}"/>
                    </StackPanel>
                </Grid>
                <Border BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,1,0,0" Padding="28,14">
                    <Button Classes="pb outline" HorizontalAlignment="Right" Click="OnCloseClick" Content="{i:Tr common.close}"/>
                </Border>
            </StackPanel>

            <!-- Available -->
            <StackPanel IsVisible="{Binding IsAvailable}">
                <StackPanel Margin="28,24,28,20" Spacing="6">
                    <TextBlock Classes="label" FontSize="12" Foreground="{StaticResource PbCyanBrush}" Text="{i:Tr upd.new_version_caps}"/>
                    <TextBlock Classes="display" FontSize="34" FontWeight="Bold" Text="{Binding AvailableTitle, Converter={x:Static c:Conv.Upper}}"
                               TextWrapping="Wrap"/>
                    <TextBlock Classes="mono" FontSize="12.5">
                        <Run Text="{Binding VersionLine}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding PublishedText}"/>
                    </TextBlock>
                </StackPanel>

                <Border BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,1,0,0" Padding="28,18,28,18"
                        IsVisible="{Binding HasNotes}">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="hdr" Text="{i:Tr upd.whats_new}"/>
                        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding NotesLines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="9"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Width="10" Height="1" Background="{StaticResource PbCyanBrush}"
                                                    VerticalAlignment="Top" Margin="0,10,0,0"/>
                                            <TextBlock Grid.Column="1" Margin="14,0,0,0" Classes="body" Text="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Classes="notice warning" Margin="28,0,28,16" IsVisible="{Binding IsMandatory}">
                    <TextBlock Classes="mono" FontSize="12" TextWrapping="Wrap" Text="{i:Tr upd.mandatory}"/>
                </Border>

                <Border BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,1,0,0" Padding="28,14">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Button Grid.Column="0" Classes="pb ghost" IsVisible="{Binding ShowSkip}"
                                Command="{Binding U.SkipCommand}" Content="{i:Tr upd.skip}"/>
                        <Button Grid.Column="2" Classes="pb outline" Margin="0,0,8,0" IsVisible="{Binding ShowLater}"
                                Command="{Binding U.LaterCommand}" Content="{i:Tr upd.later}"/>
                        <Button Grid.Column="3" Classes="pb primary" Command="{Binding U.InstallCommand}">
                            <StackPanel>
                                <c:Icon Data="{StaticResource IcoDownload}"/>
                                <TextBlock Text="{i:Tr upd.install}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Downloading / verifying / installing -->
            <StackPanel Spacing="12" IsVisible="{Binding IsProgressState}" Margin="28,26,28,30">
                <TextBlock Classes="label" FontSize="12" Foreground="{StaticResource PbCyanBrush}" Text="{Binding AvailableTitle, Converter={x:Static c:Conv.Upper}}"/>
                <TextBlock Classes="display" FontSize="28" FontWeight="SemiBold" Text="{Binding ProgressTitle, Converter={x:Static c:Conv.Upper}}"/>
                <ProgressBar Minimum="0" Maximum="100" Margin="0,6,0,0"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                <TextBlock Classes="mono" FontSize="12.5" Text="{Binding ProgressText}" IsVisible="{Binding !IsInstalling}"/>
                <TextBlock Classes="mono" FontSize="12.5" Text="{i:Tr upd.installing_text}" IsVisible="{Binding IsInstalling}"/>
            </StackPanel>

            <!-- Error -->
            <StackPanel IsVisible="{Binding IsError}">
                <Grid ColumnDefinitions="Auto,*" Margin="28,26,28,24">
                    <Border Classes="ring" BorderBrush="{StaticResource PbDangerBrush}" Width="48" Height="48" CornerRadius="24">
                        <c:Icon Data="{StaticResource IcoAlert}" Foreground="{StaticResource PbDangerTextBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Classes="display" FontSize="24" Text="{i:Tr upd.error_caps}"/>
                        <TextBlock Classes="mono" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Text="{Binding ErrorText}"/>
                    </StackPanel>
                </Grid>
                <Border BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,1,0,0" Padding="28,14">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="pb outline" Click="OnCloseClick" Content="{i:Tr common.close}"/>
                        <Button Classes="pb primary" IsVisible="{Binding CanRetryInstall}"
                                Command="{Binding U.InstallCommand}" Content="{i:Tr upd.retry}"/>
                        <Button Classes="pb primary" IsVisible="{Binding CanRetryCheck}"
                                Command="{Binding U.CheckCommand}" Content="{i:Tr upd.retry}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
