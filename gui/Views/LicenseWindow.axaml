<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyBridge.GUI.ViewModels"
        xmlns:i="using:ProxyBridge.GUI.Services"
        xmlns:c="using:ProxyBridge.GUI.Controls"
        x:Class="ProxyBridge.GUI.Views.LicenseWindow"
        x:DataType="vm:LicenseViewModel"
        x:CompileBindings="True"
        Title="{i:Tr license.window_title}"
        Icon="/Assets/logo.ico"
        Width="580" Height="560"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:LicenseViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBox.key">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.lang">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="{StaticResource PbMonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>

    <Border x:Name="Root" Background="{StaticResource PbWindowBgBrush}"
            BorderBrush="{StaticResource PbLineBrush}" BorderThickness="1">
        <Grid RowDefinitions="52,Auto,*,Auto">

            <!-- title bar -->
            <Border Grid.Row="0" BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,1,*,Auto,Auto">
                    <Border Grid.ColumnSpan="5" Background="Transparent" c:TitleDrag.IsEnabled="True"/>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="22,0,20,0"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <c:BrandMark Width="30" Height="20"/>
                        <TextBlock Text="proxybridge" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,2"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="vline"/>
                    <TextBlock Grid.Column="2" Classes="hdr" Margin="20,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Text="{i:Tr license.title_caps}"/>
                    <Border Grid.Column="3" Classes="segmented" Padding="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="pb seg lang" Classes.active="{Binding IsRussian}" Command="{Binding SetRussianCommand}" Content="RU"
                                    AutomationProperties.AutomationId="LangRu"/>
                            <Button Classes="pb seg lang" Classes.active="{Binding IsEnglish}" Command="{Binding SetEnglishCommand}" Content="EN"
                                    AutomationProperties.AutomationId="LangEn"/>
                        </StackPanel>
                    </Border>
                    <c:WindowButtons Grid.Column="4" ShowMinimize="False" ShowMaximize="False"/>
                </Grid>
            </Border>

            <!-- hero -->
            <Border Grid.Row="1" BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,0,0,1" ClipToBounds="True">
                <Panel>
                    <TextBlock Text="PB" FontFamily="{StaticResource PbDisplayFont}" FontWeight="Bold" FontSize="210"
                               Foreground="{StaticResource PbHeroLettersBrush}" HorizontalAlignment="Right"
                               VerticalAlignment="Top" Margin="0,-40,22,-90" IsHitTestVisible="False"/>
                    <StackPanel Margin="30,26,30,24" Spacing="12">
                        <StackPanel>
                            <TextBlock Classes="display" FontWeight="Bold" FontSize="46" LineHeight="48" Foreground="#FFFFFF"
                                       Text="{i:Tr license.hero1}"/>
                            <TextBlock Classes="display" FontWeight="Bold" FontSize="46" LineHeight="48"
                                       Foreground="{StaticResource PbHeroBlueBrush}" Text="{i:Tr license.hero2}"/>
                        </StackPanel>
                        <TextBlock Classes="mono" FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxWidth="400"
                                   HorizontalAlignment="Left" Text="{i:Tr license.activate_text}"/>
                    </StackPanel>
                </Panel>
            </Border>

            <!-- key -->
            <StackPanel Grid.Row="2" Margin="30,22,30,18" Spacing="12" VerticalAlignment="Center">
                <TextBlock Classes="label" FontSize="12" Foreground="{StaticResource PbMutedBrush}" Text="{i:Tr license.key_caps}"/>
                <TextBox x:Name="KeyBox" Classes="key mono"
                         Text="{Binding KeyText}"
                         Watermark="PB-XXXX-XXXX-XXXX-XXXX"
                         MaxLength="32"
                         IsEnabled="{Binding IsNotBusy}"/>
                <Button Classes="pb primary caps" Height="50" HorizontalAlignment="Stretch"
                        Command="{Binding ActivateCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        IsDefault="True">
                    <StackPanel>
                        <Arc Classes="spin" Width="16" Height="16" StrokeThickness="2" Stroke="#FFFFFF"
                             IsVisible="{Binding IsBusy}"/>
                        <TextBlock Text="{i:Tr license.activate_caps}"/>
                    </StackPanel>
                </Button>
                <TextBlock Classes="mono" FontSize="12.5" TextAlignment="Center" HorizontalAlignment="Center" MinHeight="18"
                           TextWrapping="Wrap"
                           Classes.cyan="{Binding Status.IsSuccess}"
                           Classes.danger="{Binding Status.IsError}"
                           Text="{Binding Status.Text}"/>
            </StackPanel>

            <!-- buy -->
            <Border Grid.Row="3" BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,1,0,0" Padding="30,12,30,14">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="mono" FontSize="12.5" VerticalAlignment="Center" Text="{i:Tr license.no_key}"/>
                        <Button Classes="pb link" VerticalAlignment="Center" Command="{Binding BuyCommand}">
                            <StackPanel>
                                <TextBlock Text="{i:Tr license.buy}" FontFamily="{StaticResource PbDisplayFont}" FontWeight="Medium" FontSize="16"/>
                                <c:Icon Data="{StaticResource IcoArrowUpRight}" Width="16" Height="16" StrokeThickness="1.6"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource PbMutedBrush}"
                               TextWrapping="Wrap" Text="{i:Tr license.prices}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
