<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ProxyBridge.GUI.ViewModels"
        xmlns:i="using:ProxyBridge.GUI.Services"
        xmlns:c="using:ProxyBridge.GUI.Controls"
        xmlns:p="using:ProxyBridge.GUI.Views.Pages"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="800"
        x:Class="ProxyBridge.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Icon="/Assets/logo.ico"
        Title="ProxyBridge"
        Width="1240" Height="800"
        MinWidth="1060" MinHeight="680"
        Background="{StaticResource PbBgBrush}"
        WindowStartupLocation="CenterScreen">

    <Border x:Name="Root" Background="{StaticResource PbWindowBgBrush}"
            BorderBrush="{StaticResource PbLineBrush}" BorderThickness="1">
        <Grid RowDefinitions="64,*,32">

            <!-- ================= Title bar ================= -->
            <Border Grid.Row="0" BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="264,1,Auto,*,Auto">
                    <!-- drag surface behind everything -->
                    <Border Grid.ColumnSpan="5" Background="Transparent" c:TitleDrag.IsEnabled="True"/>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="28,0,0,0"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <c:BrandMark Width="36" Height="24" VerticalAlignment="Center"/>
                        <TextBlock Text="proxybridge" FontSize="23" FontWeight="SemiBold" LetterSpacing="-0.3"
                                   VerticalAlignment="Center" Margin="0,0,0,3"/>
                    </StackPanel>

                    <Border Grid.Column="1" Classes="vline"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="28,0,0,0">
                        <Button Classes="tab" Classes.active="{Binding IsHomePage}"
                                Command="{Binding ShowHomeCommand}"
                                AutomationProperties.AutomationId="NavHome">
                            <TextBlock Text="{i:Tr tab.home}"/>
                        </Button>
                        <Button Classes="tab" Classes.active="{Binding IsProxiesPage}"
                                Command="{Binding ShowProxiesCommand}"
                                AutomationProperties.AutomationId="NavProxies">
                            <TextBlock Text="{i:Tr tab.proxies}"/>
                        </Button>
                        <Button Classes="tab" Classes.active="{Binding IsSettingsPage}"
                                Command="{Binding ShowSettingsCommand}"
                                AutomationProperties.AutomationId="NavSettings">
                            <TextBlock Text="{i:Tr tab.settings}"/>
                        </Button>
                    </StackPanel>

                    <c:WindowButtons Grid.Column="4" Margin="0,0,1,0"/>
                </Grid>
            </Border>

            <!-- ================= Pages ================= -->
            <Panel Grid.Row="1">
                <p:HomePage IsVisible="{Binding IsHomePage}"/>
                <p:ProxiesPage IsVisible="{Binding IsProxiesPage}"/>
                <p:SettingsPage IsVisible="{Binding IsSettingsPage}"/>
            </Panel>

            <!-- ================= Footer ================= -->
            <Border Grid.Row="2" BorderBrush="{StaticResource PbLineBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="28,0">
                    <Button Grid.Column="0" Classes="pb ghost" Height="31" Padding="0" Background="Transparent"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip.Tip="{i:Tr sidebar.license_tip}">
                        <StackPanel>
                            <Ellipse Classes="dot" Classes.on="{Binding HasLicense}" Width="6" Height="6"/>
                            <TextBlock Classes="label" FontSize="11.5" Foreground="{StaticResource PbText2Brush}"
                                       Text="{Binding LicenseFooterText}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="2" Classes="label" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{StaticResource PbMutedBrush}">
                        <Run Text="proxybridge v"/><Run Text="{Binding AppVersion}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
