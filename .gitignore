# Build artifacts
bin/
obj/
output/

# Compiled binaries
*.dll
!ProxyBridgeCore.dll
*.pdb
*.ilk

# Native driver
*.sys

# Logs and temp files
*.log
*.pyc
build.log
compile_output.txt
verbose.log
*.tmp

# IDE
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# User data
*.json
!gui/**/*.json

# Backup files
*.old
*.bak
*_broken.*

# Unused SVG icons (inline Viewbox+Path used instead)
gui/Assets/icon-*.svg

# System files
.DS_Store
Thumbs.db
_removed_from_repo/

# macOS / Go core build outputs
core-go/dist/
mac/dist/
mac/tools/

# Auto-update: installers are uploaded to the server, not committed; the manifest is committed
# The website lives in its own folder and on the server, not in this repository
site/

# Vendor adapters of the proxy store: deployed to the server only, never published
server/app/store/traffic.py
server/app/store/dedicated.py

# iOS build outputs
core-go/apple/out/
core-go/apple/.tmp/
apple/ios/*.xcodeproj/
apple/ios/**/Info.plist
!apple/ios/**/*.json
